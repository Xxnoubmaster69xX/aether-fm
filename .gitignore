# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Databases & logs
*.db
*.sqlite
*.db-journal
*.db-wal
*.db-shm
