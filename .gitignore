*.onnx
*.pt
*.pth
*.bin
*.index
*.ckpt
*.safetensors
**/models/


# Flutter / Android build outputs
aether-fm/mobile_app/.dart_tool/
aether-fm/mobile_app/.flutter-plugins
aether-fm/mobile_app/.flutter-plugins-dependencies
aether-fm/mobile_app/.packages
aether-fm/mobile_app/build/
*.apk

# IDE & Editor files
.idea/
.vscode/
*.iml
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Sensitive environment files
.env
*.token
